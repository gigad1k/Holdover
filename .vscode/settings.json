{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/.vsconfig": true,
        "**/*.suo": true,
        "**/*.user": true,
        "Binaries/": true,
        "DerivedDataCache/": true,
        "Intermediate/": true,
        "Saved/": true
    },
    "files.associations": {
        "*.Build.cs": "csharp",
        "*.Target.cs": "csharp",
        "*.uproject": "json",
        "*.uplugin": "json"
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj",
        "*.slnx": "*.csproj"
    },
    "dotnet.defaultSolution": "Holdover.slnx"
}
